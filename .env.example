# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put real values here.
#
# Two kinds of variable live in this file:
#   VITE_*  — inlined into the browser bundle at BUILD time. Public by
#             definition. Changing one requires a rebuild, not just a restart.
#   others  — read at RUNTIME by the serverless functions in api/ only.
#             These never reach the browser. Keep them secret.

# --- Supabase (required) ---------------------------------------------------
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Same URL again, without the VITE_ prefix, for api/_lib/auth.js + google.js.
SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard → Project Settings → API → service_role.
# BYPASSES ROW LEVEL SECURITY. Server-side only — never add a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (required for resume uploads) ---------------------------
# Cloudflare dashboard → R2. Create a bucket, then an API token with
# Object Read & Write scoped to it.
# Endpoint: R2 → Overview → "S3 API" (https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Google Drive (optional) -----------------------------------------------
# Leave VITE_ENABLE_GDRIVE unset to disable the whole feature; the rest of the
# app works without it. To enable, set it to the literal string 'true'.
VITE_ENABLE_GDRIVE=

# Google Cloud Console → APIs & Services → Credentials.
# OAuth 2.0 Client ID, type "Web application". Authorized redirect URI must be
# exactly:  https://<your-domain>/api/gdrive/callback
# (and http://localhost:3000/api/gdrive/callback for local `vercel dev`)
# Enable the "Google Drive API" and "Google Picker API" under Enabled APIs.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Same credential's client secret. Server-side only — it also keys the HMAC
# that signs the OAuth state token (api/_lib/google.js:15).
GOOGLE_CLIENT_SECRET=

# Credentials → Create credentials → API key. Restrict it to the Picker API.
VITE_GOOGLE_PICKER_API_KEY=
